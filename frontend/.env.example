# Diabetes Prediction System — Frontend Environment Configuration

# Flask API Backend Base URL
VITE_API_BASE_URL=http://127.0.0.1:5000/api

# Enable mock fallback with clear UI indicators when backend is unreachable or during standalone development
VITE_USE_MOCK_FALLBACK=true

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=10000

